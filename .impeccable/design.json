    },
    {
      "name": "Article row",
      "kind": "custom",
      "description": "Category/date, title, and summary. Generic sample content introduces no publication claims.",
      "html": "<article class=\"ds-post-row\"><div class=\"ds-post-meta\"><span>动手实践</span><span>发布日期</span></div><a class=\"ds-post-card\" href=\"/posts\"><h3 class=\"ds-post-title\">文章标题</h3><p class=\"ds-post-description\">文章摘要。</p></a></article>",
